{
  "name": "@banter/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Cliente de escritorio Electron para Banter con cumplimiento NitroPay (CMP modal, BrowserView remoto, GDPR resurface y modo Ad-Free para Nitro).",
  "author": "VANTS GAMES <contacto@vants.cc>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "cc.vants.desktop",
    "productName": "VANTS",
    "executableName": "VANTS",
    "electronVersion": "35.7.5",
    "npmRebuild": false,
    "copyright": "Copyright © 2026 VANTS GAMES",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "build/icon.png",
      {
        "from": "../web/dist",
        "to": "web-dist",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "VANTS-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "VANTS",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "VANTSGAMES",
        "repo": "banter"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "^25.1.8"
  }
}
